<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>dm42editor</RootNamespace>
    <AssemblyName>dm42editor</AssemblyName>
    <ApplicationIcon>Projet1.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>dm42editor</Product>
    <Copyright>Copyright © 2020</Copyright>
    <Version>2.2</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- WebView2 ajoute aussi sa version WPF (conflit WindowsBase) : inutile en WinForms -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- librairies tierces compilées pour .NET Framework -->
  <ItemGroup>
    <Reference Include="TabStrip">
      <HintPath>lib\TabStrip.dll</HintPath>
    </Reference>
    <Reference Include="dm42dll">
      <HintPath>..\dm42dll\bin\Debug\dm42dll.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Python -> RPN (menu Python) -->
  <ItemGroup>
    <ProjectReference Include="..\Py42\Py42.Core\Py42.Core.csproj" />
  </ItemGroup>

  <!-- fichiers de données copiés à côté de l'exe -->
  <ItemGroup>
    <None Include="data\**\*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- fichier .raw direct depuis la page Python (encodeur partagé avec Py42) -->
  <ItemGroup>
    <Compile Include="..\Py42\Shared\RawExport.cs" Link="RawExport.cs" />
  </ItemGroup>

  <!-- fichiers partiels de Form1 et fenêtre Python construite en code : ouverts en code, pas dans le Concepteur
       (sinon Visual Studio crée un .resx en double, ex. Form1.Goto.resx → erreur MSB3577) -->
  <ItemGroup>
    <Compile Update="Form1.Goto.cs;Form1.Python.cs;Form1.Flowchart.cs;Form1.Hp41.cs;Form1.Icons.cs;FrmPython.cs;FrmPython.Extras.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
